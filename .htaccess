RewriteEngine On

# Route static images to the frontend folder
RewriteRule ^images/(.*)$ frontend/images/$1 [L]
RewriteRule ^bracelet\ images/(.*)$ frontend/bracelet\ images/$1 [L]
RewriteRule ^earring\ images/(.*)$ frontend/earring\ images/$1 [L]
RewriteRule ^necklace\ images/(.*)$ frontend/necklace\ images/$1 [L]
RewriteRule ^ring\ images/(.*)$ frontend/ring\ images/$1 [L]
RewriteRule ^uploads/(.*)$ frontend/uploads/$1 [L]

# Route backend process scripts to the backend folder
RewriteRule ^insert_cart\.php$ backend/insert_cart.php [L]
RewriteRule ^remove_cart\.php$ backend/remove_cart.php [L]
RewriteRule ^sync_cart\.php$ backend/sync_cart.php [L]
RewriteRule ^update_cart_quantity\.php$ backend/update_cart_quantity.php [L]
RewriteRule ^register_process\.php$ backend/register_process.php [L]
RewriteRule ^logout\.php$ backend/logout.php [L]
RewriteRule ^p1\.php$ backend/p1.php [L]
RewriteRule ^p3\.php$ backend/p3.php [L]
RewriteRule ^p4\.php$ backend/p4.php [L]
RewriteRule ^p5\.php$ backend/p5.php [L]

# Redirect config bridge
RewriteRule ^frontend/js/supabase-config\.js$ api/supabase-config-js.php [L]
RewriteRule ^js/supabase-config\.js$ api/supabase-config-js.php [L]

# Route clean URLs and original page names to the frontend HTML folder
RewriteRule ^about$ frontend/about.html [L]
RewriteRule ^about\.html$ frontend/about.html [L]
RewriteRule ^cart$ frontend/cart.html [L]
RewriteRule ^cart\.html$ frontend/cart.html [L]
RewriteRule ^checkout$ frontend/checkout.html [L]
RewriteRule ^checkout\.html$ frontend/checkout.html [L]
RewriteRule ^contact$ frontend/contact.html [L]
RewriteRule ^contact\.html$ frontend/contact.html [L]
RewriteRule ^featured$ frontend/featured.html [L]
RewriteRule ^featured\.html$ frontend/featured.html [L]
RewriteRule ^home$ frontend/home.html [L]
RewriteRule ^home\.html$ frontend/home.html [L]
RewriteRule ^login$ frontend/login.html [L]
RewriteRule ^login\.html$ frontend/login.html [L]
RewriteRule ^product$ frontend/product.html [L]
RewriteRule ^product\.html$ frontend/product.html [L]
RewriteRule ^product-detail$ frontend/product-detail.html [L]
RewriteRule ^product-detail\.html$ frontend/product-detail.html [L]
RewriteRule ^profile$ frontend/profile.html [L]
RewriteRule ^profile\.html$ frontend/profile.html [L]
RewriteRule ^register$ frontend/register.html [L]
RewriteRule ^register\.html$ frontend/register.html [L]
RewriteRule ^shop$ frontend/shop.html [L]
RewriteRule ^shop\.html$ frontend/shop.html [L]
RewriteRule ^view-orders$ frontend/view-orders.html [L]
RewriteRule ^view-orders\.html$ frontend/view-orders.html [L]
RewriteRule ^view_orders$ frontend/view-orders.html [L]
RewriteRule ^wishlist$ frontend/wishlist.html [L]
RewriteRule ^wishlist\.html$ frontend/wishlist.html [L]

RewriteRule ^blog$ frontend/blog.html [L]
RewriteRule ^blog\.html$ frontend/blog.html [L]
RewriteRule ^blog1$ frontend/blog1.html [L]
RewriteRule ^blog1\.html$ frontend/blog1.html [L]
RewriteRule ^blog2$ frontend/blog2.html [L]
RewriteRule ^blog2\.html$ frontend/blog2.html [L]
RewriteRule ^blog3$ frontend/blog3.html [L]
RewriteRule ^blog3\.html$ frontend/blog3.html [L]

# Route root to home.html
RewriteRule ^$ frontend/home.html [L]
